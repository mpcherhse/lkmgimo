# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env в репозиторий не попадает.
# Адрес, по которому открывается кабинет (нужен для ссылок календаря и QR в справках)
LK_PUBLIC_URL=https://lk.example.ru
# Домен для автоматического HTTPS (Caddy + Let's Encrypt). Можно <ip>.sslip.io
LK_DOMAIN=lk.example.ru
# 32 случайных байта в base64: docker compose run --rm app python -m app.cli secret-key
LK_SECRET_KEY=
# Пароль базы (любой длинный случайный)
POSTGRES_PASSWORD=
# Пароли демо-аккаунтов для жюри (JSON). Пусто — сгенерируются при заполнении базы и будут выведены в консоль
LK_DEMO_PASSWORDS=
# Секрет TOTP демо-сотрудника: docker compose run --rm app python -m app.cli totp-secret
LK_DEMO_TOTP_SECRET=
# 1 — страница /staff-code с текущим кодом 2FA демо-сотрудника (только для стенда жюри)
LK_DEMO_TOTP_HELPER=0
